# Copier ce fichier en .env (jamais commité) puis adapter si besoin.

# Base de développement (docker compose up -d)
DATABASE_URL="postgresql://jobflow:jobflow@localhost:5432/jobflow_dev"

# Base des tests d'intégration (vidée à chaque test)
TEST_DATABASE_URL="postgresql://jobflow:jobflow@localhost:5432/jobflow_test"

# Stockage des pièces jointes PDF (UploadThing, ADR 0006). Jeton du tableau de bord UploadThing ;
# facultatif en test et en CI (le stockage y est remplacé par un faux).
UPLOADTHING_TOKEN=""
