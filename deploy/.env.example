# Copier en ~/jobflow-prod/.env sur la Pi, puis `chmod 600 .env`. Jamais commité.

# Mot de passe de la base de production (long et aléatoire : `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Jeton UploadThing (pièces jointes, même app que le développement — BR-010-04).
UPLOADTHING_TOKEN=

# Clé de l'assistant IA (ADR 0008), facultative : https://aistudio.google.com
GEMINI_API_KEY=

# Version de l'image à faire tourner : `latest`, ou `sha-<commit>` pour un retour arrière.
JOBFLOW_VERSION=latest

# Canal secret des alertes sur le téléphone (ntfy, SPEC-012) : un nom aléatoire, ex. `jobflow-$(openssl rand -hex 12)`.
NTFY_TOPIC=
