// Modèle de données — SPEC-001 §7. Vocabulaire : CONTEXT.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Trois statuts seulement (décision du 2026-09-27) : Postulée → Entretien → Refusée.
enum ApplicationStatus {
  APPLIED
  INTERVIEW
  REJECTED
}

enum ContractType {
  CDI
  CDD
  INTERNSHIP
  APPRENTICESHIP
  GRADUATE_PROGRAM
  FREELANCE
  TEMPORARY
  OTHER
}

enum ApplicationSource {
  LINKEDIN
  INDEED
  WELCOME_TO_THE_JUNGLE
  APEC
  FRANCE_TRAVAIL
  COMPANY_WEBSITE
  SCHOOL
  REFERRAL
  SPONTANEOUS
  OTHER
}

enum SalaryPeriod {
  YEARLY
  MONTHLY
}

/// Type d'un Entretien (SPEC-003).
enum InterviewType {
  HR
  TECHNICAL
  MANAGER
  FINAL
  OTHER
}

enum InterviewFormat {
  ON_SITE
  VIDEO
  PHONE
}

enum AttachmentKind {
  CV
  COVER_LETTER
}

/// L'utilisateur unique (créé par la migration `single_user`). Présent pour ne pas fermer la porte au multi-utilisateur (ADR 0001).
model User {
  id           String        @id @default(uuid()) @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz
  companies    Company[]
  applications Application[]
  attachments  Attachment[]
  interviews   Interview[]
  profile      Profile?
}

/// Entreprise — nom unique par utilisateur, sans distinction de casse (BR-001-11).
model Company {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(200)
  normalizedName String        @db.VarChar(200)
  website        String?       @db.VarChar(2048)
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
  applications   Application[]

  @@unique([userId, normalizedName])
}

/// Candidature — porte les champs de son Annonce.
model Application {
  id               String                    @id @default(uuid()) @db.Uuid
  userId           String                    @db.Uuid
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String                    @db.Uuid
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status           ApplicationStatus
  jobTitle         String                    @db.VarChar(200)
  location         String?                   @db.VarChar(200)
  contractType     ContractType?
  jobUrl           String?                   @db.VarChar(2048)
  source           ApplicationSource?
  jobDescription   String?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?                   @db.Char(3)
  salaryPeriod     SalaryPeriod?
  appliedAt        DateTime?                 @db.Date
  notes            String?
  /// Brouillon de lettre de motivation (SPEC-008), généré puis modifié par l'utilisateur.
  coverLetterDraft String?
  /// Analyse de l'Annonce par l'assistant (SPEC-007), au format vérifié par `jobAnalysisSchema`.
  jobAnalysis      Json?
  createdAt        DateTime                  @default(now()) @db.Timestamptz
  updatedAt        DateTime                  @updatedAt @db.Timestamptz
  statusChanges    ApplicationStatusChange[]
  attachments      Attachment[]
  interviews       Interview[]

  @@index([userId, status])
  @@index([userId, updatedAt])
}

/// Historique des statuts — une ligne par changement, y compris la création (FR-001-06).
model ApplicationStatusChange {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedAt     DateTime           @default(now()) @db.Timestamptz

  @@index([applicationId, changedAt])
}

/// Pièce jointe — CV ou lettre de motivation en PDF, stocké chez UploadThing (ADR 0006) :
/// la base ne garde que sa référence, jamais le fichier.
model Attachment {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String         @db.Uuid
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          AttachmentKind
  fileKey       String         @unique @db.VarChar(256)
  url           String         @db.VarChar(2048)
  name          String         @db.VarChar(255)
  size          Int
  createdAt     DateTime       @default(now()) @db.Timestamptz

  @@unique([applicationId, kind])
}

/// Entretien (rendez-vous) d'une Candidature (SPEC-003). L'heure est un instant UTC, saisie et
/// affichée à l'heure de Paris ; l'Interlocuteur est du texte libre (pas encore de fiche Contact).
model Interview {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String          @db.Uuid
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime        @db.Timestamptz
  type          InterviewType
  format        InterviewFormat
  location      String?         @db.VarChar(500)
  interviewer   String?         @db.VarChar(200)
  preparation   String?
  debrief       String?
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime        @updatedAt @db.Timestamptz

  @@index([userId, scheduledAt])
  @@index([applicationId, scheduledAt])
}

/// Profil (SPEC-006) : ce que l'assistant saura de moi pour écrire mes lettres. Un seul par
/// utilisateur, en texte libre ; tous les champs sont facultatifs.
model Profile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String?  @db.VarChar(200)
  targetRole     String?  @db.VarChar(200)
  location       String?  @db.VarChar(200)
  email          String?  @db.VarChar(200)
  phone          String?  @db.VarChar(40)
  linkedinUrl    String?  @db.VarChar(2048)
  about          String?
  experience     String?
  projects       String?
  skills         String?
  education      String?
  writingSamples String?
  updatedAt      DateTime @updatedAt @db.Timestamptz
}
