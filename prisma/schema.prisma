// Modèle de données — SPEC-001 §7. Vocabulaire : CONTEXT.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Trois statuts seulement (décision du 2026-09-27) : Postulée → Entretien → Refusée.
enum ApplicationStatus {
  APPLIED
  INTERVIEW
  REJECTED
}

enum ContractType {
  CDI
  CDD
  INTERNSHIP
  APPRENTICESHIP
  GRADUATE_PROGRAM
  FREELANCE
  TEMPORARY
  OTHER
}

enum ApplicationSource {
  LINKEDIN
  INDEED
  WELCOME_TO_THE_JUNGLE
  APEC
  FRANCE_TRAVAIL
  COMPANY_WEBSITE
  SCHOOL
  REFERRAL
  SPONTANEOUS
  OTHER
}

enum SalaryPeriod {
  YEARLY
  MONTHLY
}

enum AttachmentKind {
  CV
  COVER_LETTER
}

/// L'utilisateur unique (seed). Présent pour ne pas fermer la porte au multi-utilisateur (ADR 0001).
model User {
  id           String        @id @default(uuid()) @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz
  companies    Company[]
  applications Application[]
  attachments  Attachment[]
}

/// Entreprise — nom unique par utilisateur, sans distinction de casse (BR-001-11).
model Company {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(200)
  normalizedName String        @db.VarChar(200)
  website        String?       @db.VarChar(2048)
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
  applications   Application[]

  @@unique([userId, normalizedName])
}

/// Candidature — porte les champs de son Annonce.
model Application {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @db.Uuid
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String                    @db.Uuid
  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status         ApplicationStatus
  jobTitle       String                    @db.VarChar(200)
  location       String?                   @db.VarChar(200)
  contractType   ContractType?
  jobUrl         String?                   @db.VarChar(2048)
  source         ApplicationSource?
  jobDescription String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?                   @db.Char(3)
  salaryPeriod   SalaryPeriod?
  appliedAt      DateTime?                 @db.Date
  notes          String?
  createdAt      DateTime                  @default(now()) @db.Timestamptz
  updatedAt      DateTime                  @updatedAt @db.Timestamptz
  statusChanges  ApplicationStatusChange[]
  attachments    Attachment[]

  @@index([userId, status])
  @@index([userId, updatedAt])
}

/// Historique des statuts — une ligne par changement, y compris la création (FR-001-06).
model ApplicationStatusChange {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedAt     DateTime           @default(now()) @db.Timestamptz

  @@index([applicationId, changedAt])
}

/// Pièce jointe — CV ou lettre de motivation en PDF, stocké chez UploadThing (ADR 0006) :
/// la base ne garde que sa référence, jamais le fichier.
model Attachment {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String         @db.Uuid
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          AttachmentKind
  fileKey       String         @unique @db.VarChar(256)
  url           String         @db.VarChar(2048)
  name          String         @db.VarChar(255)
  size          Int
  createdAt     DateTime       @default(now()) @db.Timestamptz

  @@unique([applicationId, kind])
}
